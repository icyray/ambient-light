<UserControl x:Class="AmbientLight.Controls.LedRingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 灯带环形示意图: 每颗 LED 画在它的物理位置 (绕向/边分配与核心 capture.cpp
         BuildRects 一致), 颜色 = 最近一帧下发数据 (ACStatus.ledRgb) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ItemsControl x:Name="TopStrip" Grid.Row="0" Grid.Column="1" Margin="2,2,2,0"
                      HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="LeftStrip" Grid.Row="1" Grid.Column="0" Margin="2,2,0,2"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Grid.Row="1" Grid.Column="1" Margin="8,4,8,4" CornerRadius="8"
                Background="#16161C" BorderBrush="#2E2E38" BorderThickness="1"
                MinHeight="56">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="HintTitle" Text="LED 预览" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" Opacity="0.85" />
                <TextBlock x:Name="HintText" Text="" FontSize="11" Opacity="0.5"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="12,2,12,0" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="RightStrip" Grid.Row="1" Grid.Column="2" Margin="0,2,2,2"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="BottomStrip" Grid.Row="2" Grid.Column="1" Margin="2,0,2,2"
                      HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
