<UserControl x:Class="AmbientLight.Controls.LedRingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 灯带环绕示意图: 中央暗色矩形 = 目标屏幕 (真实长宽比), LED 按物理位置均匀环绕
         (边数分配/绕向/灯序偏移与核心 capture.cpp BuildRects 同构),
         颜色 = 最近一帧下发数据 (ACStatus.ledRgb)。画布尺寸由屏幕比例计算得出, 控件内居中 -->
    <Grid>
        <!-- Viewbox: 窗口变窄时整体等比缩小 (Max 限制为原始尺寸, 不放大) -->
        <Viewbox x:Name="RingBox" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="RingCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Viewbox>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                Background="Transparent" IsHitTestVisible="False">
            <StackPanel>
            <!-- 中心提示文字。**不再有底衬**（2026-10-07 方案 2）：底衬原本是为"矩形恒暗、文字却跟主题"
                 这个错配准备的 —— 现在整支外观由 `Surface` 一个开关驱动（深面 = 暗矩形 + 白字 /
                 浅面 = 浅矩形 + 主题字），同一场景里文字背后的东西永远与它同深浅，底衬就没有必要了。
                 `MaxWidth=300`：文字**不随** Viewbox 缩放（字号固定），所以用固定上限让它换行 ——
                 正常窗口下屏幕矩形的渲染宽约 320px，300 足以让文字落在"屏幕"里；
                 只有窗口拉到最小高度时矩形会缩到 ~150px，那时文字会轻微溢出（底色同深浅，仍可读）。
                 文字色由 code-behind 按 Surface 赋（见 LedRingView.xaml.cs 的 ApplySurface）。 -->
            <StackPanel x:Name="HintBlock" MaxWidth="300">
                <TextBlock x:Name="HintTitle" Text="{DynamicResource Ring.Preview}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="HintText" Text="" FontSize="11" Visibility="Collapsed"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
                <!-- 校准向导的"安装示意"（起点徽标 + 绕向箭头）**不在这里** ——
                     它画在灯环画布上（`LedRingView.RebuildGuide`）：起点徽标贴在 0 号灯那个
                     **角**上、绕向用一条环线 + 箭头表示，整层随 Viewbox 缩放、与灯珠同坐标。
                     旧版是这里的一行小字 ("起点 0 号" + `↺ 逆时针`), 已改为画在灯环画布上的示意:
                     ① "0 号"这个数字没有信息量（起点恒为 0 号灯）；
                     ② 文字说不清"灯带怎么绕" —— 画出来才直观。 -->
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
