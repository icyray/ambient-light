<UserControl x:Class="AmbientLight.Controls.LedRingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 灯带环绕示意图: 中央暗色矩形 = 目标屏幕 (真实长宽比), LED 按物理位置均匀环绕
         (边数分配/绕向/灯序偏移与核心 capture.cpp BuildRects 同构),
         颜色 = 最近一帧下发数据 (ACStatus.ledRgb)。画布尺寸由屏幕比例计算得出, 控件内居中 -->
    <Grid>
        <!-- Viewbox: 窗口变窄时整体等比缩小 (Max 限制为原始尺寸, 不放大) -->
        <Viewbox x:Name="RingBox" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="RingCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Viewbox>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                Background="Transparent" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="HintTitle" Text="LED 预览" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" Opacity="0.85" />
                <TextBlock x:Name="HintText" Text="" FontSize="11" Opacity="0.5"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="12,2,12,0" />
                <!-- 校准向导中心区 (M5.1 §7): 0 号灯起点徽标 + 绕向箭头 —— 主页不用, 那儿的中心
                     只放静态几何参数 (SetOrientation 控制显隐)。 -->
                <StackPanel x:Name="OrientationRow" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border CornerRadius="9" Padding="8,2,8,2" Background="#40FFFFFF">
                        <TextBlock x:Name="StartBadge" Text="起点 0 号" FontSize="11"
                                   Foreground="#FFFFFFFF" />
                    </Border>
                    <TextBlock x:Name="DirArrow" Text="↺" FontSize="17" Margin="10,0,0,0"
                               Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                    <TextBlock x:Name="DirText" Text="逆时针" FontSize="11" Margin="4,0,0,0"
                               Foreground="#B3FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
