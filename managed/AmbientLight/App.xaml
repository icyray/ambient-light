<Application x:Class="AmbientLight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ⚠️ M5.2 主题 (见 Services/ThemeService.cs): 这两条是**硬约束**, 别动 ——
                     1. ThemesDictionary 必须是 Application.Resources.MergedDictionaries 的**直接成员**:
                        ApplicationThemeManager.Apply 靠
                        ResourceDictionaryManager("wpf.ui;").UpdateDictionary("theme", …) 按
                        "Source 同时含 wpf.ui; 与 theme" 找它**整个替换**; 找不到就静默 return(不抛异常)。
                        所以不能把它挪进嵌套 ResourceDictionary, 也不能改名/换类型。
                     2. Theme="Dark" 必须显式写: ThemesDictionary 无参构造默认是 Light,
                        运行时主题由 ThemeService 在启动期 Apply 覆盖; 去掉这行启动会先闪一下浅色。
                     深色既是启动期的兜底值, 也是 app.json 缺省时的默认主题 (M5.2 D2 定稿: 默认深色)。 -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- M5.2: 应用自己的"说明 / 提示文字"刷子 (次级文字)。
                 ⚠️ 不用 WPF-UI 的 TextFillColorTertiaryBrush: 浅色主题下它是 #72000000 (45% 黑),
                 叠在卡片底上对比度只有 ~3.3 → 说明文字发虚。这里声明**深色主题的值**作为初值,
                 真正的值由 Services/ThemeService.WriteAppBrushes 在每次 Apply 时按主题改写
                 (浅色 → #99000000)。所以**不要**在这里改成 DynamicResource 或删掉它 ——
                 删掉会让页面引用解析失败 (静默变黑字)。
                 初值 = 深色主题下 WPF-UI tertiary 的实测色 (#87FFFFFF), 也就是深色观感不变的那个值。 -->
            <SolidColorBrush x:Key="AppTextHintBrush" Color="#87FFFFFF" />
            <!-- M5.1: 页内分组小标签 (组内卡片间距 4px, 组间靠标签上边距拉开);
                 Foreground 必须显式给主题色——StackPanel 直属的 TextBlock 不在
                 CardForeground 继承链内, 默认会是黑色 (深色主题不可读) -->
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="4,14,4,6" />
            </Style>

            <!-- 只留图标的按钮模板 (轮 18 ②, 轮 29 提到 App 级共用): 去掉底/边框/悬停填充/按下填充,
                 只保留一个悬停淡入, 视觉上就是一个可点的图标。保留 ui:Button 宿主是为了沿用
                 Click / 键盘 / ToolTip。⚠️ 不要用 Template="{x:Null}" —— 模板为 null 什么都不渲染。 -->
            <ControlTemplate x:Key="IconOnlyButtonTemplate" TargetType="ui:Button">
                <ContentPresenter x:Name="IconHost" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Opacity="0.7" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="IconHost" Property="Opacity" Value="1" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
