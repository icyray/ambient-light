<Application x:Class="AmbientLight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ⚠️ M5.2 主题 (见 Services/ThemeService.cs): 这两条是**硬约束**, 别动 ——
                     1. ThemesDictionary 必须是 Application.Resources.MergedDictionaries 的**直接成员**:
                        ApplicationThemeManager.Apply 靠
                        ResourceDictionaryManager("wpf.ui;").UpdateDictionary("theme", …) 按
                        "Source 同时含 wpf.ui; 与 theme" 找它**整个替换**; 找不到就静默 return(不抛异常)。
                        所以不能把它挪进嵌套 ResourceDictionary, 也不能改名/换类型。
                     2. Theme="Dark" 必须显式写: ThemesDictionary 无参构造默认是 Light,
                        运行时主题由 ThemeService 在启动期 Apply 覆盖; 去掉这行启动会先闪一下浅色。
                     深色既是启动期的兜底值, 也是 app.json 缺省时的默认主题 (M5.2 D2 定稿: 默认深色)。 -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- ⚠️ 必须排在 `ui:ControlsDictionary` **之后**: 这是本地魔改的滑块皮肤
                     (进度填充 + 禁用态, 上游 4.3.0 都没有), 靠"隐式样式后加载者优先"覆盖它。
                     说明与迁移指南见 Styles/SliderStyle.xaml 头部 + docs/SLIDER_TEMPLATE.md -->
                <ResourceDictionary Source="Styles/SliderStyle.xaml" />
                <!-- M5.3 i18n: 文案字典 (唯一文案源; C# 走 Loc.T/Loc.F, XAML 走 {DynamicResource}).
                     这里只合并**中文**那本 —— 语言切换 = Services/LanguageService 运行时把这一项
                     换成 Strings.en.xaml (与主题换字典同款, 已实现; 「跟随系统」走系统显示语言) -->
                <ResourceDictionary Source="Localization/Strings.zh.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- M5.2 文字色层级的用法约定 (别再自造"提示文字"刷子):
                   · 正文/标题 → 继承 `CardForeground` (= `TextFillColorPrimary`)
                   · 次要/副标题/说明文字 → `TextFillColorSecondaryBrush`
                   · 更弱的辅助文字 → `TextFillColorTertiaryBrush`（浅色主题下它只有 45% 黑,
                     落在卡片底上对比度 3.3 —— 只在你确认那一处不需要多清楚时才用）
                   · 禁用态 → `TextFillColorDisabledBrush`
                 不要用 Opacity 压暗文字: 浅色主题下会直接掉到 3:1 以下。 -->
            <!-- M5.1: 页内分组小标签 (组内卡片间距 4px, 组间靠标签上边距拉开);
                 Foreground 必须显式给主题色——StackPanel 直属的 TextBlock 不在
                 CardForeground 继承链内, 默认会是黑色 (深色主题不可读) -->
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="4,14,4,6" />
            </Style>

            <!-- SettingRow 的头部结构 (标题 + 说明两行)。控件构造期只装一次, 之后 Title/Description
                 变化只改这两行文本 —— 结构在 XAML, 代码不重复生成 (全项目 ~30 处 SettingRow)。
                 空说明时由代码把第二行 Collapsed (不留空行)。 -->
            <DataTemplate x:Key="SettingRowHeaderTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="" FontSize="12" Margin="0,2,8,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- 只留图标的按钮模板 (App 级共用): 去掉底/边框/悬停填充/按下填充,
                 只保留一个悬停淡入, 视觉上就是一个可点的图标。保留 ui:Button 宿主是为了沿用
                 Click / 键盘 / ToolTip。⚠️ 不要用 Template="{x:Null}" —— 模板为 null 什么都不渲染。 -->
            <ControlTemplate x:Key="IconOnlyButtonTemplate" TargetType="ui:Button">
                <ContentPresenter x:Name="IconHost" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Opacity="0.7" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="IconHost" Property="Opacity" Value="1" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
