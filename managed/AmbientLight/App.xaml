<Application x:Class="AmbientLight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- M5.1: 页内分组小标签 (组内卡片间距 4px, 组间靠标签上边距拉开);
                 Foreground 必须显式给主题色——StackPanel 直属的 TextBlock 不在
                 CardForeground 继承链内, 默认会是黑色 (深色主题不可读) -->
            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="4,14,4,6" />
            </Style>

            <!-- 只留图标的按钮模板 (轮 18 ②, 轮 29 提到 App 级共用): 去掉底/边框/悬停填充/按下填充,
                 只保留一个悬停淡入, 视觉上就是一个可点的图标。保留 ui:Button 宿主是为了沿用
                 Click / 键盘 / ToolTip。⚠️ 不要用 Template="{x:Null}" —— 模板为 null 什么都不渲染。 -->
            <ControlTemplate x:Key="IconOnlyButtonTemplate" TargetType="ui:Button">
                <ContentPresenter x:Name="IconHost" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Opacity="0.7" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="IconHost" Property="Opacity" Value="1" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
