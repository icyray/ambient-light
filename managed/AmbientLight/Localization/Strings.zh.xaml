<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ════════════════════════════════════════════════════════════════════
         Strings.zh.xaml — 全部 C# 侧用户可见文案的**唯一源** (M5.3 i18n 第一步)。
         规则:
           1) 键稳定、值可改 —— 顺文案 / 翻译只动本文件 (5.3 加 Strings.en.xaml), 不动代码;
           2) 值不带首尾空白 (空格在调用处拼); 换行写 &#10;;
           3) {0}/{1} 是 string.Format 占位; 字面大括号写 {{ }} (string.Format 会还原);
           4) 键名约定: `Metric.*` 与 MetricKeysForMode 的键一一对应 (探针按前缀判漏配);
              `Mode.Name.<n>` / `Mode.Desc.<n>` 由 ModeCatalog 消费; 其余按区域分组。
         读取: C# 走 Localization/Loc.T / Loc.F; XAML (第二步) 走 {DynamicResource 键}。
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ===== 通用 ===== -->
    <sys:String x:Key="Common.Close">关闭</sys:String>
    <sys:String x:Key="Common.Cancel">取消</sys:String>
    <sys:String x:Key="Common.GotIt">知道了</sys:String>
    <sys:String x:Key="Common.EnumSep">、</sys:String>

    <!-- ===== 指标标签 (与 MetricKeysForMode 的键对应) ===== -->
