<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================================
         Slider 皮肤 (本地魔改) —— 见 docs/SLIDER_TEMPLATE.md 的完整说明与迁移指南
         ============================================================================
         来源: WPF-UI **4.3.0** `src/Wpf.Ui/Controls/Slider/Slider.xaml` 的 `UiHorizontalSlider`。
         为什么自己抄一份: 上游模板缺两样我们都要的东西, 而且**从外面改不了** ——
           · 没有 `PART_SelectionRange` → 官方进度填充机制(IsSelectionRangeEnabled/SelectionStart/End)全失效;
           · `ControlTemplate.Triggers` 只有 TickPlacement×3 + IsMouseOver → **禁用态没有任何视觉变化**;
           · 两个 RepeatButton 的 Style 是模板内 `StaticResource` 写死的 → 也不能从外部覆盖。
         因此本文件 = **上游模板逐字照抄 + 三处改动**(下面标 ①②③), 刻意保持最小差异, 便于以后升级时 diff。

         ⚠️ 维护约定 (两条, 都踩过):
           1. 引上游资源一律 `DynamicResource` —— 换主题时 WPF-UI 会**整个替换**主题字典,
              `StaticResource` 会钉住替换前的实例 (见 MEMORY: 「StaticResource 钉死」那条)。
           2. 本字典必须在 `App.xaml` 的 `MergedDictionaries` 里**排在 `ui:ControlsDictionary` 之后**
              —— 隐式样式同键时"后加载者优先", 排前面会被上游覆盖掉。
         ============================================================================ -->

    <ControlTemplate x:Key="AppHorizontalSlider" TargetType="{x:Type Slider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TickBar x:Name="TopTick" Grid.Row="0" Height="6"
                     Fill="{DynamicResource SliderTickBarFill}"
                     Placement="Top" SnapsToDevicePixels="True" Visibility="Collapsed" />
            <Border x:Name="TrackBackground" Grid.Row="1" Height="4" Margin="0"
                    Background="{DynamicResource SliderTrackFill}"
                    BorderThickness="0" CornerRadius="2" />

            <!-- ① 进度填充 (官方机制): `PART_SelectionRange` 必须由 Slider 自己**按名字**找到 →
                 这个名字不能改; 它必须能吃到 `Canvas.SetLeft` → 所以外面要套一层 Canvas。

                 ⚠️ 图层顺序: 必须**在 TrackBackground 之后、Track 之前** ——
                   放 Track 之后会盖住拇指 (拇指本该在最上层), 放 TrackBackground 之前则被轨道底色压掉。
                 ⚠️ 对齐: 外面这层 Canvas 自己**对齐到行中央且只有 4px 高** ——
                   因为 Canvas 的子元素会忽略 VerticalAlignment (只认 Canvas.Top),
                   而不同 WPF 版本可能不设置 Top (SetLeft 是必设的) → 这样 4px 的填充与 4px 的轨道必然同高。
                 填充色 = 拇指中心那个色刷 (`SliderThumbBackground`: 拇指模板里 Ellipse 的
                   Fill=TemplateBinding Foreground, 而样式把 Foreground 设成它) → 天然随主题变 ✓ -->
            <Canvas x:Name="SelectionRangeHost" Grid.Row="1" Height="4"
                    VerticalAlignment="Center" IsHitTestVisible="False">
                <Rectangle x:Name="PART_SelectionRange" Height="4" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource SliderThumbBackground}" />
            </Canvas>

            <Track x:Name="PART_Track" Grid.Row="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge"
                                  Style="{DynamicResource UiSliderButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{DynamicResource UiSliderThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge"
                                  Style="{DynamicResource UiSliderButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>

            <TickBar x:Name="BottomTick" Grid.Row="2" Height="6"
                     Fill="{DynamicResource SliderTickBarFill}"
                     Placement="Bottom" SnapsToDevicePixels="True" Visibility="Collapsed" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Background"
                        Value="{DynamicResource SliderTrackFillPointerOver}" />
                <Setter TargetName="Thumb" Property="Foreground"
                        Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
                <!-- ③ 悬停时填充跟着拇指一起换色 (否则拇指变色了、填充还是旧色, 看着不协调) -->
                <Setter TargetName="PART_SelectionRange" Property="Fill"
                        Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
            </Trigger>

            <!-- ② 禁用态 (上游缺失 → 补上)。三处一起设: 轨道 / 拇指 / **填充** ——
                 填充漏掉的话, 禁用滑块会拖着一根彩色进度条, 看着像"还能动" ✗
                 (主页 MCU 模式禁用亮度滑块就是靠这一条) -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TrackBackground" Property="Background"
                        Value="{DynamicResource ControlFillColorDisabledBrush}" />
                <Setter TargetName="Thumb" Property="Foreground"
                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                <Setter TargetName="PART_SelectionRange" Property="Fill"
                        Value="{DynamicResource ControlFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 隐式样式: 覆盖 WPF-UI 的同名隐式样式 (靠 App.xaml 的合并顺序取胜)。
         除"横向模板"外, 其余属性照抄上游 (MinWidth/MinHeight/焦点样式/OverridesDefaultStyle)。
         进度填充默认对**所有**滑块生效: 起点 = Minimum, 终点 = Value。
         乘数型滑块 (中性值在中间: 色相/三通道增益, 都是 0..2 而中性 = 1) 在页面上单独写
         `SelectionStart="1"` → 填充变成"相对中性的偏移量", 比"从 0 拉满"直观得多 ✓
         (竖直方向复用上游模板, 我们目前没有竖直滑块; 将来加了也不会缺模板) -->
    <Style TargetType="{x:Type Slider}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsSelectionRangeEnabled" Value="True" />
        <Setter Property="SelectionStart"
                Value="{Binding Minimum, RelativeSource={RelativeSource Self}}" />
        <Setter Property="SelectionEnd"
                Value="{Binding Value, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="MinHeight" Value="21" />
                <Setter Property="Template" Value="{StaticResource AppHorizontalSlider}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="MinWidth" Value="21" />
                <Setter Property="MinHeight" Value="104" />
                <Setter Property="Template" Value="{DynamicResource UiVerticalSlider}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
