<ui:FluentWindow x:Class="AmbientLight.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:AmbientLight.Views"
                 Title="AmbientLight" Width="760" Height="760"
                 MinWidth="560" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AmbientLight" />

        <ui:NavigationView Grid.Row="1" x:Name="RootNav"
                           PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           OpenPaneLength="160"
                           IsTopSeparatorVisible="False" IsFooterSeparatorVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type views:HomePage}" />
                <ui:NavigationViewItem Content="采集" Icon="{ui:SymbolIcon Desktop24}"
                                       TargetPageType="{x:Type views:SettingsPageCapture}" />
                <ui:NavigationViewItem Content="颜色" Icon="{ui:SymbolIcon Color24}"
                                       TargetPageType="{x:Type views:SettingsPageColor}" />
                <ui:NavigationViewItem Content="高级" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:SettingsPageAdvanced}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
