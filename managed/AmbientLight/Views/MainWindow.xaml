<ui:FluentWindow x:Class="AmbientLight.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:AmbientLight.Views"
                 Title="AmbientLight" Width="880" Height="680"
                 MinWidth="600" MinHeight="230"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <!-- Mica 半透明 (PROJECT_PLAN §8.2): **必须在 XAML 上声明 WindowBackdropType**, 不能手搓。
         FluentWindow 在 OnSourceInitialized 里跑的是完整序列:
           SetWindowChrome() → RemoveBackground() → ApplyBackdrop() → RemoveTitlebarBackground()
         轮 25 之前我们自己在 Loaded 里手搓了"后三步", 缺 SetWindowChrome() 与 RemoveTitlebarBackground(),
         时机也从 OnSourceInitialized 挪到了 Loaded → 一直不生效。
         ⚠️ ExtendsContentIntoTitleBar 必须为 True —— FluentWindow.OnBackdropTypeChanged 里
         这一条不满足会直接抛 InvalidOperationException。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AmbientLight" />

        <!-- SizeChanged = 自适应折叠左侧菜单 (轮 20): 变窄自动折叠 / 变宽恢复, 详见 MainWindow.xaml.cs -->
        <ui:NavigationView Grid.Row="1" x:Name="RootNav"
                           PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           OpenPaneLength="160"
                           SizeChanged="OnRootNavSizeChanged"
                           IsTopSeparatorVisible="False" IsFooterSeparatorVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="主页" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type views:HomePage}" />
                <ui:NavigationViewItem Content="追光" Icon="{ui:SymbolIcon Desktop24}"
                                       TargetPageType="{x:Type views:SettingsPageCapture}" />
                <ui:NavigationViewItem Content="拾音" Icon="{ui:SymbolIcon SoundWaveCircle24}"
                                       TargetPageType="{x:Type views:SettingsPageAudio}" />
                <ui:NavigationViewItem Content="颜色" Icon="{ui:SymbolIcon Color24}"
                                       TargetPageType="{x:Type views:SettingsPageColor}" />
                <ui:NavigationViewItem Content="高级" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:SettingsPageAdvanced}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- ContentDialog 宿主 (轮 21)。WPF-UI 的 ContentDialog.ShowAsync() 必须有一个宿主
             (ContentPresenter 那套已标记 Obsolete, 4.3 推荐 ContentDialogHost), 否则抛
             "DialogHost was not set" —— 而那只在用户点按钮时才暴露, 所以这里放好并铺满整窗 (最后
             一个子元素 = 盖在最上层)。空着时没有内容, 不挡下面的操作;
             IsDisableSiblingsEnabled: 对话框打开期间禁用兄弟元素 (标题栏/导航), 保证是模态的 ——
             这类确认框不能允许用户同时去点别处。 -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="2"
                              IsDisableSiblingsEnabled="True" />
    </Grid>
</ui:FluentWindow>
