<Page x:Class="AmbientLight.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <!-- 轮 26 (M5.1 主页构件重设计, 依据 docs/M5.1_HOME_REDESIGN_PLAN.md §2~§7):
         §4 banner 底边辉光 (LightsLayer 内的 GlowBand: Blur + 上透下实 OpacityMask, 圆角自持);
         §2 固件特效改图标磁贴网格 (FxTileTemplate), 折叠头右侧「当前 XX」胶囊;
         §3 纯色拾色器改 HSV (H/S 两根, V = 主页「亮度」行; 删 RGB 滑块);
         §5 运行指标压成一行状态条, 指标集随模式换 (指标须"不适用 = —", 不显示 0.0);
         §6 设备信息结构化 (类型图标 + 名称 + 语义胶囊 + 第二行小字; 「当前」= 左侧 3px 强调条);
         §7 几何环收进折叠「布局预览」, 中心只放静态几何参数。
         轮 19: DEV_LOST/ERROR 时 banner **不点亮** (渐变 = "确实驱动上了灯带");
            提示条只用 InfoBar 自己的 IsOpen, 不叠 AnimatedVisibility (模板自己设 Collapsed, 动画无效)。
         轮 18: MCU 光带改中性白灰; 设备列表刷新按钮纯图标; 开启失败不进入假"开启"态。
         轮 17: 去掉抖动噪点层; 光层 Rectangle 必须自带 RadiusX/RadiusY=7 (WPF Border 不裁子元素)。
         轮 16: 模式卡选中色用 AccentFillColorDefaultBrush (SystemAccentColorPrimaryBrush 是写死的 #0067c0);
            选中底色铺满整卡 (Padding 挂在 ContentPresenter 上); 亮度行紧贴 banner。 -->
    <Page.Resources>
        <!-- 模式卡模板: 选中 = 强调色 1px 描边 + 淡强调色底 (铺满, Tint 层 14%) + 右上对勾 -->
        <ControlTemplate x:Key="ModeCardTemplate" TargetType="RadioButton">
            <Border x:Name="Root" Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Border x:Name="Tint" CornerRadius="8" Opacity="0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    <ContentPresenter Margin="14,16" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" />
                    <ui:SymbolIcon x:Name="CheckIcon" Symbol="Checkmark24" FontSize="14"
                                   Margin="0,12,12,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="Collapsed" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                    <Setter TargetName="Root" Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Root" Property="Background"
                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 固件特效磁贴模板 (§2): 与模式卡同一套视觉语言 (强调描边 + 14% 淡强调底 + 右上对勾),
             但尺寸更紧凑 —— 24px 图标 + 名称, 最小宽 152 / 高 56。
             轮 28: ContentPresenter 加 HorizontalAlignment="Center" —— "居中"指的是**磁贴内的
             内容**居中 (图标+文字原来贴左边); 磁贴组本身的对齐方式不动。 -->
        <ControlTemplate x:Key="FxTileTemplate" TargetType="RadioButton">
            <Border x:Name="Root" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Border x:Name="Tint" CornerRadius="6" Opacity="0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    <ContentPresenter Margin="12,8" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    <ui:SymbolIcon x:Name="CheckIcon" Symbol="Checkmark24" FontSize="12"
                                   Margin="0,6,6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="Collapsed" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                    <Setter TargetName="Root" Property="BorderBrush"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Root" Property="Background"
                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 模式区样式与图标底 (控件本体在下方 PrimaryModeGrid/FxPanel 静态声明, 这里只放"长什么样"):
             · ⚠️ 必须 BasedOn 隐式的 RadioButton 样式: WPF 里**显式样式会整体替换隐式样式** ——
               不 BasedOn 的话会静默丢掉主题的字色/字体 (白字变黑字), 而且只在出图上肉眼可见;
             · GroupName 也在这里统一 (卡片组 / 磁贴组互不干扰)。
             图标底渐变 = 同色系"亮→深" (追光蓝 / 拾音绿 / 纯色紫), 与旧代码
             `new LinearGradientBrush(from, to, 50.0)` 的实际端点一致 (WPF 折算: Start=(0,0),
             End=(cos50°, sin50°) —— 是"左上→右下"的向下方, 别按数学系的角度改。 -->
        <Style x:Key="ModeCardStyle" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Template" Value="{StaticResource ModeCardTemplate}" />
            <Setter Property="GroupName" Value="PrimaryModes" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="96" />
        </Style>
        <Style x:Key="FxTileStyle" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Template" Value="{StaticResource FxTileTemplate}" />
            <Setter Property="GroupName" Value="FxTiles" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="152" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <LinearGradientBrush x:Key="ModeTileChaseBrush" StartPoint="0,0" EndPoint="0.642788,0.766044">
            <GradientStop Offset="0" Color="#FF46CCFC" />
            <GradientStop Offset="1" Color="#FF2E80D7" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ModeTileAudioBrush" StartPoint="0,0" EndPoint="0.642788,0.766044">
            <GradientStop Offset="0" Color="#FF61EDD4" />
            <GradientStop Offset="1" Color="#FF0DA2AA" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ModeTileSolidBrush" StartPoint="0,0" EndPoint="0.642788,0.766044">
            <GradientStop Offset="0" Color="#FFCA9FF1" />
            <GradientStop Offset="1" Color="#FF8F68C9" />
        </LinearGradientBrush>

        <!-- 布尔 → Visibility (显示器行的「主屏 / 正在采集」标记用; WPF 自带转换器) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 显示器行模板 (由 MonitorsList 逐行渲染):
             · 编号徽标 = 自绘正圆 (库里的 NumberCircle1..9 实测渲染不出数字; 强调色底 + 反白数字);
             · 分辨率主信息色、适配器次要色 (它只是"哪块卡带出来的");
             · 「正在采集」的配色由数据项携带 (ThemePalette 纯函数, 随主题深浅)。 -->
        <DataTemplate x:Key="MonitorRowTemplate">
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="{Binding Number}" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,8,0">
                    <TextBlock Text="{Binding ResolutionText}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding AdapterText}" FontSize="11.5" Margin="10,0,8,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="9" Padding="7,1,7,1" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="主屏" FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border CornerRadius="9" Padding="7,1,7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{Binding CaptureBg}"
                            Visibility="{Binding Capturing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="正在采集" FontSize="10.5" Foreground="{Binding CaptureFg}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 设备行模板 (每台一行, §6): 类型图标 + 名称 + 语义胶囊 + 右侧动作; COM/供电/灯数下沉第二行。
             「当前」设备用左侧 3px 强调条 + 强调色胶囊标出。
             语义规则 (胶囊/端口/配对) 全在 code-behind 的纯函数里 —— 本模板只负责摆结构。 -->
        <DataTemplate x:Key="DeviceRowTemplate">
            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 当前条 (未选中收起; 列宽固定 3px, 显隐不引起布局跳动) -->
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,0,2"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}" />
                <!-- 类型图标: 独立一列、两行整体垂直居中 -->
                <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="18"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="2" Margin="10,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NameText}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <!-- 「当前」胶囊: 强调色**底**上的字必须用 TextOnAccentFillColorPrimaryBrush
                             (用 AccentTextFillColorPrimaryBrush = 强调色写强调色, 看不见字) -->
                        <Border CornerRadius="9" Padding="7,1,7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="当前" FontSize="10.5"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <!-- 语义胶囊 (配色由数据项携带; 文案/色调口径见 DevicePill) -->
                        <Border CornerRadius="9" Padding="7,1,7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center" Background="{Binding PillBg}">
                            <TextBlock Text="{Binding PillLabel}" FontSize="10.5"
                                       Foreground="{Binding PillFg}" />
                        </Border>
                    </StackPanel>
                    <!-- 第二行小字 (空则不占位); 警示色由数据项给 (端口不一致/不在位时) -->
                    <TextBlock Text="{Binding Line2Text}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{Binding Line2Brush}"
                               Visibility="{Binding HasLine2, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding ToggleText}" Appearance="{Binding ToggleAppearance}"
                               Margin="0,0,6,0" IsEnabled="{Binding Usable}" MinWidth="64"
                               Click="OnDeviceToggleClick" />
                    <ui:Button Content="设为当前" Appearance="Secondary" MinWidth="76"
                               IsEnabled="{Binding Usable}"
                               Visibility="{Binding ShowSelectButton, Converter={StaticResource BoolToVis}}"
                               Click="OnDeviceSelectClick" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 只留图标的按钮模板已提到 App.xaml (轮 29: 采集页/拾音页也要用同一个) -->

        <!-- 预设色板单个色块 (轮 27, 轮 28 修同心, 轮 29 去掉"原始/生效色"行):
             必须是**圆形**, 悬停**不能**套用 Button 默认模板的灰色高亮。
             几何 (全部非负 Margin 居中 → 天然同心):
               实心圆   Margin=4   → 半径 11
               选中圈   Margin=3   → 半径 12, 粗 2 → 覆盖 11~13 (内沿 11 = 实心圆外沿, 无缝)
               悬停圈   Margin=1.5 → 半径 13.5, 粗 1 → 覆盖 13~14 (内沿 13 = 选中圈外沿, 也无缝)
             (上一版实心圆 Margin=3、圈 Margin=0, 中间空出 2px 深色环, 看着就是"圆和圆环不同心"。)
             按钮的 BorderBrush 只在选中/未选中之间换色 —— 未选中给一个深灰描边, 免得出现"空圈"。 -->
        <ControlTemplate x:Key="PresetSwatchTemplate" TargetType="Button">
            <Grid Width="30" Height="30" Background="Transparent">
                <Ellipse Fill="{TemplateBinding Background}" Margin="3.5" />
                <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="3" Margin="1.5" />
                <Ellipse x:Name="HoverRing" Margin="0.5" Opacity="0" StrokeThickness="3"
                         Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverRing" Property="Opacity" Value="0.7" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 色相轨道彩虹渐变 (§3): 0°红 60°黄 120°绿 180°青 240°蓝 300°品红 360°红 -->
        <LinearGradientBrush x:Key="HueRainbowBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.0000" Color="#FFFF3B30" />
            <GradientStop Offset="0.1667" Color="#FFFFCC00" />
            <GradientStop Offset="0.3333" Color="#FF34C759" />
            <GradientStop Offset="0.5000" Color="#FF32D0E0" />
            <GradientStop Offset="0.6667" Color="#FF007AFF" />
            <GradientStop Offset="0.8333" Color="#FFAF52DE" />
            <GradientStop Offset="1.0000" Color="#FFFF3B30" />
        </LinearGradientBrush>

        <!-- banner 深色渐变底: 多段 + 低对比 (段数多本身不消带; 小跨度 + 长缓坡已足够平滑,
             轮 17 已去掉抖动噪点层 —— 无时域抖动时静态噪点只会让画面发脏) -->
        <LinearGradientBrush x:Key="BannerBaseBrush" StartPoint="0,0.08" EndPoint="1,0.92">
            <GradientStop Offset="0" Color="#FF0A2337" />
            <GradientStop Offset="0.35" Color="#FF10222D" />
            <GradientStop Offset="0.7" Color="#FF17242A" />
            <GradientStop Offset="1" Color="#FF1F2324" />
        </LinearGradientBrush>
        <!-- ★ D1-B 实验分支: 浅色主题下"点亮态"的**浅底** (原方案 A 是"点亮态恒深色")。
             走向与深色版一致 (冷色 → 中性), 只是整体翻转成浅色。
             调这里 = 调浅色主题下 banner 的底色观感 (探针会算"点亮态文字 vs 这个底"的对比度)。 -->
        <LinearGradientBrush x:Key="BannerBaseLightBrush" StartPoint="0,0.08" EndPoint="1,0.92">
            <GradientStop Offset="0" Color="#FFE3F0FA" />
            <GradientStop Offset="0.35" Color="#FFEBF2F7" />
            <GradientStop Offset="0.7" Color="#FFF0F4F6" />
            <GradientStop Offset="1" Color="#FFF4F6F7" />
        </LinearGradientBrush>
        <!-- 模式色光带: 长缓 alpha 坡 (0→13→58→70→26→0), 端点全透明 → 无硬边 -->
        <LinearGradientBrush x:Key="BannerStreakBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0D3E91E0" />
            <GradientStop Offset="0.38" Color="#3A3E91E0" />
            <GradientStop Offset="0.52" Color="#463E91E0" />
            <GradientStop Offset="0.72" Color="#1A3E91E0" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerStreakGreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0D21BCBA" />
            <GradientStop Offset="0.38" Color="#3A21BCBA" />
            <GradientStop Offset="0.52" Color="#4621BCBA" />
            <GradientStop Offset="0.72" Color="#1A21BCBA" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerStreakPurpleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0DA679DC" />
            <GradientStop Offset="0.38" Color="#3AA679DC" />
            <GradientStop Offset="0.52" Color="#46A679DC" />
            <GradientStop Offset="0.72" Color="#1AA679DC" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
        <!-- 固件特效 (MCU) 光带: 中性白灰 —— MCU 由灯带自己渲染, 既不取色也不律动,
             用中性色而不是琥珀, 免得跟"琥珀=等待/警告"的状态色语义打架 -->
        <LinearGradientBrush x:Key="BannerStreakMonoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0DE4EBF2" />
            <GradientStop Offset="0.38" Color="#3AE4EBF2" />
            <GradientStop Offset="0.52" Color="#46E4EBF2" />
            <GradientStop Offset="0.72" Color="#1AE4EBF2" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>

        <!-- ================= 浅色主题版光带 (D1-B) =================
             命名约定: **浅色版 = 深色版 key + "Light" 后缀**, 一一对应。
             解析只在 code-behind 的 `StreakBrushKey(mode, dark)` 一处做 —— 调参就改这一组,
             别在调用点写"如果浅色就用另一个"的分支。
             初始值 = 深色版那一组 (所以浅色主题现在的观感就是你已验收的 B 方案不变);
             想调浅色主题下光带的浓淡/色相, 就改下面这四条的 GradientStop。

             为什么 Blue/Green/Purple 直接照抄深色版: 它们的峰值 alpha 只有 27%,
             饱和色叠在浅底上从"发光"变成"淡彩" (实测 |ΔL| 0.239, 看得见) —— 这是审美取舍, 你调。
             ⚠️ **Mono 例外** (刻意不照抄): #E4EBF2 是近白灰, 叠在浅底上没有亮度差 → 等于看不见。
             所以浅色版给了一档中灰 #9AA7B4, 保证"固件特效"在浅色主题下也有光带。 -->
        <LinearGradientBrush x:Key="BannerStreakBlueBrushLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0DADCFF6" />
            <GradientStop Offset="0.38" Color="#3AADCFF6" />
            <GradientStop Offset="0.52" Color="#46ADCFF6" />
            <GradientStop Offset="0.72" Color="#1AADCFF6" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerStreakGreenBrushLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0DBCF1F0" />
            <GradientStop Offset="0.38" Color="#3ABCF1F0" />
            <GradientStop Offset="0.52" Color="#46BCF1F0" />
            <GradientStop Offset="0.72" Color="#1ABCF1F0" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerStreakPurpleBrushLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0DE8C7F9" />
            <GradientStop Offset="0.38" Color="#3AE8C7F9" />
            <GradientStop Offset="0.52" Color="#46E8C7F9" />
            <GradientStop Offset="0.72" Color="#1AE8C7F9" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
        <!-- Mono 的浅色版: 一档中灰 (深色版的 #E4EBF2 在浅底上等于看不见) -->
        <LinearGradientBrush x:Key="BannerStreakMonoBrushLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.00" Color="#00000000" />
            <GradientStop Offset="0.18" Color="#0DBFD9E6" />
            <GradientStop Offset="0.38" Color="#3ABFD9E6" />
            <GradientStop Offset="0.52" Color="#46BFD9E6" />
            <GradientStop Offset="0.72" Color="#1ABFD9E6" />
            <GradientStop Offset="1.00" Color="#00000000" />
        </LinearGradientBrush>
    </Page.Resources>
    <StackPanel Margin="16,12,16,16">

        <!-- Hero banner. 底 = 普通卡片灰; LightsLayer = 点亮时的深色渐变 + 模式色光带 + 底边辉光,
             整层 Opacity 淡入淡出; StreakA/B 交叉淡化实现换模式的平滑过渡。
             **三条光层都是 Rectangle, 必须显式写 RadiusX/RadiusY**: WPF 的 Border 只把
             自己的 Background 裁到圆角, **不会裁子元素** → 不加圆角的 Rectangle 会把 banner
             四角撑成直角 (灰色态是圆角、点亮态却变直角)。内圆角 = 外 8 − 边框 1 = 7。 -->
        <Border x:Name="Banner" Height="160" CornerRadius="8" ClipToBounds="True"
                Margin="0,0,0,4" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid x:Name="LightsLayer" Opacity="0" IsHitTestVisible="False">
                    <Rectangle x:Name="BannerBase" RadiusX="7" RadiusY="7"
                               Fill="{StaticResource BannerBaseBrush}" />
                    <Rectangle x:Name="StreakA" RadiusX="7" RadiusY="7"
                               Fill="{StaticResource BannerStreakBlueBrush}" />
                    <Rectangle x:Name="StreakB" RadiusX="7" RadiusY="7"
                               Fill="{StaticResource BannerStreakBlueBrush}" Opacity="0" />
                    <!-- §4 底边辉光带 (轮 27 重做): 形状(中心亮→两边衰减)与颜色只跟**模式**有关,
                         所以画刷是静态的、由 code-behind 按模式换; 每次只改 Opacity (= 数值大小)。
                         这样视觉上是 WPF 动画插值出的 60fps, 不再每帧重建 64 段画刷 (那正是卡顿来源)。
                         **不亮的地方是透明的 (alpha=0), 不是黑色** —— 辉光是"叠加上去"的, 不能压成黑带。
                         OpacityMask 做"上透下实"; 圆角自持 (Border 不裁子元素)。
                         LightsLayer 整层淡变 → 关灯时辉光跟着回卡片灰。 -->
                    <Border x:Name="GlowBand" Height="56" VerticalAlignment="Bottom"
                            CornerRadius="0,0,7,7" Opacity="0">
                        <Border.Effect>
                            <BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Performance" />
                        </Border.Effect>
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="0.45" Color="#66FFFFFF" />
                                <GradientStop Offset="1" Color="#FFFFFFFF" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                </Grid>
                <Grid Margin="20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border x:Name="StatePill" HorizontalAlignment="Left" CornerRadius="10"
                                Padding="9,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="6" Height="6"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatePillText" Text="已停止" FontSize="11"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="HeroTitle" Text="追光" FontSize="24" FontWeight="SemiBold"
                                   Margin="0,10,0,0" />
                        <TextBlock x:Name="HeroSub" Text="跟随屏幕边缘取色, 实时同步画面" FontSize="13"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PortText" Text="未连接设备" FontSize="12"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:Button x:Name="ToggleBtn" Appearance="Primary" Content="开启"
                                   Padding="24,8" Click="OnToggle" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="BannerFpsText" Grid.Row="1" Text="0.0 FPS" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 提示 (原 WarnText/DiagText): IsClosable=False —— 条件消失时自动收起,
             免得用户手动关掉后又被 4Hz 轮询重新打开。
             轮 19: **不加 AnimatedVisibility** —— InfoBar 模板是用 IsOpen 直接切 Visibility(Collapsed)
             的, Collapsed 的元素整个退出布局, 高度动画就没有任何可见效果; 两者只能取其一,
             用户选择保留 IsOpen 的原生行为 (瞬时显隐)。见 PROGRESS 轮 19。 -->
        <ui:InfoBar x:Name="WarnBar" Margin="0,0,0,4" Severity="Warning" Title="画面提示"
                    IsOpen="False" IsClosable="False" />
        <ui:InfoBar x:Name="DiagBar" Margin="0,0,0,4" Severity="Error" Title="核心诊断"
                    IsOpen="False" IsClosable="False" />

        <!-- 亮度 (常用功能 → 紧贴 banner)。§3: 这一行同时就是纯色拾色器的 V (明度) —— 不再另设第三根滑块 -->
        <controls:SettingRow x:Name="BrightnessRow" Margin="0,0,0,4"
                             Icon="{ui:SymbolIcon BrightnessHigh24}" Title="亮度"
                             Description="追光/纯色直接调光; 拾音律动作为最高亮度上限">
            <StackPanel Orientation="Horizontal">
                <!-- 轨道点击/拖动由 SliderJump 附加行为接管; ValueChanged 不能在 XAML
                     接线: InitializeComponent 设初值时会在读取配置前触发, 把默认值
                     写进配置文件 (M1 教训), 订阅在 OnLoaded -->
                <TextBlock x:Name="BrightnessValueText" Text="100%" MinWidth="44" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="BrightnessSlider" Width="200" Minimum="0" Maximum="100" Value="100"
                        LargeChange="0" controls:SliderJump.Enabled="True"
                        VerticalAlignment="Center" />
            </StackPanel>
        </controls:SettingRow>

        <!-- 模式: 三张主模式卡 (等宽三列 + 8px 间隙; 控件本体静态声明, 样式见 ModeCardStyle)。
             Tag = 模式号, 供 code-behind 收集后同步选中态; 点选统一走 Checked=OnModeChecked。 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="模式" />
        <Grid x:Name="PrimaryModeGrid" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 追光 (mode 0): 44px 圆角渐变图标 + 标题 + 一句功能说明 -->
            <RadioButton Grid.Column="0" Style="{StaticResource ModeCardStyle}" Tag="0"
                         Checked="OnModeChecked">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="8" VerticalAlignment="Center"
                            Margin="0,0,12,0" Background="{StaticResource ModeTileChaseBrush}">
                        <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="24" Filled="True"
                                       Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="屏幕追光" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="跟随屏幕边缘取色, 实时同步画面" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- 拾音 (mode 1) -->
            <RadioButton Grid.Column="2" Style="{StaticResource ModeCardStyle}" Tag="1"
                         Checked="OnModeChecked">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="8" VerticalAlignment="Center"
                            Margin="0,0,12,0" Background="{StaticResource ModeTileAudioBrush}">
                        <ui:SymbolIcon Symbol="SoundWaveCircle24" FontSize="24" Filled="True"
                                       Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="拾音律动" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="跟随系统声音或麦克风律动" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- 纯色 (mode 11) -->
            <RadioButton Grid.Column="4" Style="{StaticResource ModeCardStyle}" Tag="11"
                         Checked="OnModeChecked">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="8" VerticalAlignment="Center"
                            Margin="0,0,12,0" Background="{StaticResource ModeTileSolidBrush}">
                        <ui:SymbolIcon Symbol="Color24" FontSize="24" Filled="True"
                                       Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="纯色灯光" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="整条灯带单色, 无需画面" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- §3 纯色灯光拾色器: 仅「纯色灯光」模式时显示 (AnimatedVisibility), 且显示时默认折叠 —
             H + S 两根滑块即完整 HSV (V = 上方「亮度」行), 精确匹配走 Header 的 HEX 框 -->
        <ui:CardExpander x:Name="SolidCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon Color24}"
                         ContentPadding="0" IsExpanded="False"
                         controls:AnimatedVisibility.Expanded="False">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="纯色灯光" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="当前模式的灯光颜色 — 原始色 (未含亮度)" />
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,4,0">
                        <Border x:Name="SolidPreview" Width="32" Height="32" CornerRadius="6"
                                Background="#FFE1D6"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="HexBox" Width="120" Text="#FFE1D6" MaxLength="9"
                                    VerticalAlignment="Center" TextChanged="OnHexChanged" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel Margin="16,12,16,16">
                <!-- 预设色板 + 自定义槽: 12 个预设 → 竖分割线 → 5 个自定义槽
                     (自动记住调出来的颜色, 右键清除单个槽)。选中 = 强调色圆环。
                     色块模板 = PresetSwatchTemplate (自绘圆点; 默认 Button 模板的悬停会铺灰)。
                     ⚠️ 自定义槽**不要**在 XAML 里写 Tag —— code-behind 靠"收集时有无 Tag"分拣
                     预设/自定义 (之后 RefreshCustomSlots 会往空槽写 Tag)。 -->
                <WrapPanel x:Name="PresetStrip" Margin="0,0,0,4">
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FFE1D6" ToolTip="暖白 #FFE1D6" Tag="#FFE1D6"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FFF6E0" ToolTip="米白 #FFF6E0" Tag="#FFF6E0"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FFFFFF" ToolTip="纯白 #FFFFFF" Tag="#FFFFFF"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#C9E4FF" ToolTip="冷白 #C9E4FF" Tag="#C9E4FF"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FF3B30" ToolTip="红 #FF3B30" Tag="#FF3B30"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FF9500" ToolTip="橙 #FF9500" Tag="#FF9500"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FFCC00" ToolTip="黄 #FFCC00" Tag="#FFCC00"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#34C759" ToolTip="绿 #34C759" Tag="#34C759"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#5AC8FA" ToolTip="青 #5AC8FA" Tag="#5AC8FA"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#007AFF" ToolTip="蓝 #007AFF" Tag="#007AFF"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#AF52DE" ToolTip="紫 #AF52DE" Tag="#AF52DE"
                            Click="OnPresetClick" />
                    <Button Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="#FF2D55" ToolTip="粉 #FF2D55" Tag="#FF2D55"
                            Click="OnPresetClick" />

                    <!-- 预设与自定义之间的竖向分割线 -->
                    <Rectangle Width="1" Height="30" Margin="6,0,10,6"
                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <!-- 自定义色槽 ×5 (内容/描边由 RefreshCustomSlots 按记忆填充; 右键清除) -->
                    <Button x:Name="CustomSlot0" Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="Transparent" ToolTip="自定义色槽 · 调出颜色后自动记住"
                            Click="OnPresetClick" MouseRightButtonUp="OnCustomSlotClear" />
                    <Button x:Name="CustomSlot1" Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="Transparent" ToolTip="自定义色槽 · 调出颜色后自动记住"
                            Click="OnPresetClick" MouseRightButtonUp="OnCustomSlotClear" />
                    <Button x:Name="CustomSlot2" Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="Transparent" ToolTip="自定义色槽 · 调出颜色后自动记住"
                            Click="OnPresetClick" MouseRightButtonUp="OnCustomSlotClear" />
                    <Button x:Name="CustomSlot3" Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="Transparent" ToolTip="自定义色槽 · 调出颜色后自动记住"
                            Click="OnPresetClick" MouseRightButtonUp="OnCustomSlotClear" />
                    <Button x:Name="CustomSlot4" Width="30" Height="30" Margin="0,0,6,6" Cursor="Hand"
                            Template="{StaticResource PresetSwatchTemplate}"
                            BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="Transparent" ToolTip="自定义色槽 · 调出颜色后自动记住"
                            Click="OnPresetClick" MouseRightButtonUp="OnCustomSlotClear" />
                </WrapPanel>

                <!-- 色相 H: 彩虹轨道。滑块自身的轨道用局部资源刷覆盖成透明, 渐变交给下层 Border 承担
                     (WPF-UI 4.3.0 模板里轨道是 Border#TrackBackground, Background = SliderTrackFill)。 -->
                <Grid x:Name="HueRow" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource HueRainbowBrush}"/>
                        <TextBlock Text="色相" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="HValueText" Grid.Column="1" Text="24" MinWidth="36"
                               TextAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center" />
                    <Grid Grid.Column="2" Width="200" VerticalAlignment="Center">
                        <Border x:Name="HueTrackBar" Height="4" CornerRadius="2"
                                VerticalAlignment="Center" Background="{StaticResource HueRainbowBrush}" />
                        <!-- Fill=None: 这个滑块的"轨道"是它自己画的彩虹色带 (HueTrackBar),
                             所以不画进度填充 —— 否则会把渐变换盖掉 (用户实测反馈) ✓ -->
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="24"
                                LargeChange="0" controls:SliderJump.Enabled="True"
                                controls:SliderSkin.Fill="None"
                                VerticalAlignment="Center">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                </Grid>

                <!-- 饱和度 S: 轨道 = 当前 H 的灰 → 全饱和 (H 变化时重画) -->
                <Grid x:Name="SatRow" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SatSwatch" Width="16" Height="16" CornerRadius="8" Background="#FFFF3B30"/>
                        <TextBlock Text="饱和度" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SValueText" Grid.Column="1" Text="22" MinWidth="36"
                               TextAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center" />
                    <Grid Grid.Column="2" Width="200" VerticalAlignment="Center">
                        <Border x:Name="SatTrackBar" Height="4" CornerRadius="2"
                                VerticalAlignment="Center" />
                        <!-- Fill=None: 同 HueSlider —— 轨道是自绘的饱和度色带 ✓ -->
                        <Slider x:Name="SatSlider" Minimum="0" Maximum="100" Value="22"
                                LargeChange="0" controls:SliderJump.Enabled="True"
                                controls:SliderSkin.Fill="None"
                                VerticalAlignment="Center">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                            </Slider.Resources>
                        </Slider>
                    </Grid>
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- §2 固件特效: 图标磁贴网格 (位于拾色器之后; IsExpanded 跟随 MCU 模式自动展开)。
             折叠头右侧钉「当前 XX」胶囊 —— 收起状态也能一眼看到正在用哪款。 -->
        <ui:CardExpander x:Name="FxExpander" Margin="0,0,0,4" Icon="{ui:SymbolIcon Sparkle24}"
                         ContentPadding="0">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="固件特效" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="11 款 · 由灯带固件渲染, 主机仅发命令 (无预览)" />
                    <Border x:Name="FxCurrentPill" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            CornerRadius="10" Padding="8,2" Margin="8,0,4,0"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <!-- ⚠️ 强调色**底**上的文字要用 TextOnAccentFillColorPrimaryBrush;
                             用 AccentTextFillColorPrimaryBrush 会变成"强调色写强调色"→ 看不见字
                             (轮 27 用户报的"不明橙色胶囊"就是这个)。 -->
                        <TextBlock x:Name="FxCurrentText" FontSize="11"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </ui:CardExpander.Header>
            <WrapPanel x:Name="FxPanel" Margin="16,12,16,8">
                <!-- 固件特效磁贴 (静态声明; 与固件模式表一一对应 —— 探针断言"磁贴数 == MCU 模式数",
                     加新款特效时这里要同步). 图标只表达"是哪一款", 不暗示配色 (固件自己渲染配色)。
                     Tag = 模式号; 点选统一走 Checked=OnModeChecked。 -->
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="2" Checked="OnModeChecked"
                             ToolTip="彩虹跳跃 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ColorFill24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="彩虹跳跃" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="3" Checked="OnModeChecked"
                             ToolTip="海浪潮汐 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Water24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="海浪潮汐" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="4" Checked="OnModeChecked"
                             ToolTip="电闪雷鸣 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="电闪雷鸣" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="5" Checked="OnModeChecked"
                             ToolTip="呼吸心跳 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="呼吸心跳" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="6" Checked="OnModeChecked"
                             ToolTip="火焰燃烧 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Fire24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="火焰燃烧" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="7" Checked="OnModeChecked"
                             ToolTip="南极光彩 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WeatherSnowflake24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="南极光彩" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="8" Checked="OnModeChecked"
                             ToolTip="粒子碰撞 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Molecule24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="粒子碰撞" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="9" Checked="OnModeChecked"
                             ToolTip="圣诞节日 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Gift24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="圣诞节日" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="10" Checked="OnModeChecked"
                             ToolTip="变幻莫测 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wand24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="变幻莫测" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="12" Checked="OnModeChecked"
                             ToolTip="浓情夏日 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Beach24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="浓情夏日" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FxTileStyle}" Tag="13" Checked="OnModeChecked"
                             ToolTip="北极冰山 · 由灯带固件渲染, 主机只下发命令">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WeatherSnow24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="北极冰山" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </WrapPanel>
        </ui:CardExpander>

        <!-- §5 运行指标 (轮 27 双层 / 轮 29 关闭时自动动画收起)。
             收起用 AnimatedVisibility (与拾音页「输入/输出设备」同一套机制): 灯带没开的时候
             这块整个高度收掉, 不留一行占位; 开起来再动画展开。
             指标集随模式换 (MetricKeysForMode 纯函数); 不做健康着色。 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="调试信息" />
        <!-- §7 布局预览 (折叠): 几何环保留 M4 的真实比例几何, 但日常收起不参与 4Hz 重绘;
             中心区只放**静态几何参数** —— 展开它的人目的是核对灯序/边数/偏移, 要的就是几何事实。
             起点序号与绕向箭头移进校准向导中心区 (Views/CalibrateWindow.xaml)。 -->
        <ui:CardExpander x:Name="LayoutCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon BorderAll24}"
                         ContentPadding="0" IsExpanded="False">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="布局预览" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="按真实长宽比核对灯序与边数" />
                    <TextBlock x:Name="LayoutSummary" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                               FontSize="12" Margin="8,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </ui:CardExpander.Header>
            <!-- 高度由 LedRingView 按灯数/边数自适应 (纵向列不截断) -->
            <controls:LedRingView x:Name="Ring" MinHeight="150" MaxHeight="220" Margin="16,12,16,16"/>
        </ui:CardExpander>
        <ui:Card x:Name="MetricsCard" Padding="16,10" Margin="0,0,0,4"
                 controls:AnimatedVisibility.Expanded="False">
            <Grid>
                <!-- 指标格: 等宽分栏 (UniformGrid 单行), 每格 = 标签上 / 数值下;
                     数值经 {Binding Value} 刷新 (MetricCell 是 INPC 数据项)。
                     指标集随模式换 (MetricKeysForMode 纯函数)。 -->
                <ItemsControl x:Name="MetricsPanel" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="11"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,2,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 未开启 (无指标集) 时的一行灰字占位 (不铺 0.0: 0 会被读成"卡住了") -->
                <TextBlock x:Name="MetricsEmptyText" Text="未开启 · 指标在灯带运行后显示" FontSize="12"
                           HorizontalAlignment="Center" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </ui:Card>

        <!-- §6 设备 / 显示器 (结构化行) -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="设备" />
        <ui:Card>
            <StackPanel>
                <Grid>
                    <TextBlock Text="连接设备" FontWeight="SemiBold" />
                    <!-- 只要图标, 不要按钮样式 (轮 18 ②) -->
                    <ui:Button x:Name="RefreshDevicesBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                               ToolTip="刷新"
                               HorizontalAlignment="Right" Click="OnRefreshDevices">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" Margin="8,2"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>
                <StackPanel x:Name="DevicesPanel" Margin="0,8,0,0">
                    <ItemsControl x:Name="DevicesList" ItemTemplate="{StaticResource DeviceRowTemplate}" />
                    <TextBlock x:Name="DevicesStateText" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
                <Separator Margin="0,10" />
                <Grid>
                    <TextBlock Text="显示器" FontWeight="SemiBold" />
                    <ui:Button x:Name="RefreshMonitorsBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                               ToolTip="重新枚举"
                               HorizontalAlignment="Right" Click="OnRefreshMonitorsClick">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" Margin="8,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ui:Button>
                </Grid>
                <!-- 显示器行 (模板 MonitorRowTemplate); 采集目标不在此切换 (选择器在「采集」页)。
                     行列表与状态/提示文本是**动态内容**, 由 code-behind 填/控制显隐。 -->
                <StackPanel x:Name="MonitorsPanel" Margin="0,8,0,0">
                    <ItemsControl x:Name="MonitorsList" ItemTemplate="{StaticResource MonitorRowTemplate}" />
                    <TextBlock x:Name="MonitorsStateText" FontSize="12" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="MonitorsHintText" Text="切换采集目标在「采集」页" FontSize="12"
                               Margin="0,4,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

    </StackPanel>
</Page>
