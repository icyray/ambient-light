<Page x:Class="AmbientLight.Views.SettingsPageAdvanced"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <StackPanel Margin="16,4,16,16">

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <TextBlock Text="LED 最小亮度" FontWeight="SemiBold" />
                    <TextBlock x:Name="MinBrightnessValue" Text="1" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="MinBrightnessSlider" controls:SliderJump.Enabled="True" Minimum="1" Maximum="25" Value="1"
                        ValueChanged="OnMinBrightnessChanged" Margin="0,8,0,0" />
                <TextBlock Text="RGB 全部低于该级别时抬升到该灰度, 避免灯带彻底熄灭。"
                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="锁屏 / 熄屏 / 切换时灯带策略" FontWeight="SemiBold" />
                <ComboBox x:Name="WaitDispCombo" Margin="0,8,0,0" SelectionChanged="OnWaitDispChanged">
                    <ComboBoxItem Content="熄灭 (默认, 全零帧)" />
                    <ComboBoxItem Content="最暗 (最小亮度灰帧)" />
                    <ComboBoxItem Content="保持最后画面" />
                </ComboBox>
                <TextBlock Text="仅屏幕追光模式受熄屏影响; 进入状态时发一帧策略帧, 每 2s 重发防固件掉电丢帧。"
                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="低灰保真修正 (colorfix)" FontWeight="SemiBold" />
                        <TextBlock Text="厂商原链会把暗灰色放大成蓝绿色; 开启后按绝对色度门限钳为中性灰。"
                                   Opacity="0.45" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ColorfixToggle" HorizontalAlignment="Right"
                                     Click="OnColorfixChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="色度噪声门限 (sfloor)" VerticalAlignment="Center" />
                    <TextBlock x:Name="SfloorValue" Grid.Column="1" Text="24" />
                </Grid>
                <Slider x:Name="SfloorSlider" controls:SliderJump.Enabled="True" Minimum="0" Maximum="255" Value="24"
                        ValueChanged="OnSfloorChanged" Margin="0,8,0,0" />
                <TextBlock Text="8bit max-min 低于该门限视为采样噪声 (0-255, 默认 24)。"
                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="测试图 / 屏幕校准" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button x:Name="PatternQuadBtn" Content="四象限色块" Margin="0,0,8,0"
                               Click="OnPatternQuad" />
                    <ui:Button x:Name="PatternMagentaBtn" Content="洋红常亮" Margin="0,0,8,0"
                               Click="OnPatternMagenta" />
                    <ui:Button x:Name="CalibrateBtn" Content="全屏校准向导…" Appearance="Secondary"
                               Click="OnCalibrate" />
                </StackPanel>
                <TextBlock Text="测试图覆盖正常追光画面; 再次点击同一按钮关闭。四象限色块用于核对方向/灯数/分段, 与厂商校准图同构。全屏校准向导在目标显示器上铺四色大图, 就近微调灯序偏移。"
                           Opacity="0.6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="定时开启" FontWeight="SemiBold" />
                        <TextBlock Text="每天到点自动开启灯带 (当天只自动开一次, 手动关闭不会被再次拉起); 时刻未到时应用启动不亮灯。"
                                   Opacity="0.45" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoOnToggle" HorizontalAlignment="Right"
                                     Click="OnAutoOnChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开启时刻" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:TimePicker x:Name="AutoOnTimePicker" Grid.Column="1" Width="140"
                                   ClockIdentifier="Clock24Hour" HorizontalAlignment="Left" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="开机自启" FontWeight="SemiBold" />
                        <TextBlock Text="登录 Windows 后自动运行 (在 shell:startup 写入 .url 快捷方式, 不动注册表)"
                                   Opacity="0.45" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoStartToggle" HorizontalAlignment="Right"
                                     Click="OnAutoStartChanged" />
                </Grid>
                <TextBlock x:Name="AutoStartPathText" Text="" Opacity="0.4" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
                <Separator Margin="0,10" />
                <Grid>
                    <StackPanel>
                        <TextBlock Text="启动时自动开启灯带" FontWeight="SemiBold" />
                        <TextBlock Text="应用启动后立即连接设备并恢复上次模式 (开机自启后无需手动开启); 设备未就绪时核心自动重连"
                                   Opacity="0.45" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoStartCoreToggle" HorizontalAlignment="Right"
                                     Click="OnAutoStartCoreChanged" />
                </Grid>
                <Separator Margin="0,10" />
                <Grid>
                    <StackPanel>
                        <TextBlock Text="启动时收进托盘" FontWeight="SemiBold" />
                        <TextBlock Text="启动后不显示主窗口, 仅托盘图标 (配合开机自启使用)"
                                   Opacity="0.45" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="StartMinimizedToggle" HorizontalAlignment="Right"
                                     Click="OnStartMinimizedChanged" />
                </Grid>
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="配置目录" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfigDirText" Text="" Opacity="0.7" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="打开" Appearance="Secondary"
                           VerticalAlignment="Center" Margin="8,0,0,0" Click="OnOpenConfigDir" />
            </Grid>
        </ui:Card>

        <TextBlock x:Name="VersionText" Text="" Opacity="0.4" FontSize="11"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Page>
