<Page x:Class="AmbientLight.Views.SettingsPageAdvanced"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <StackPanel Margin="16,4,16,16">

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <TextBlock Text="LED 最小亮度" FontWeight="SemiBold" />
                    <TextBlock x:Name="MinBrightnessValue" Text="1" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="MinBrightnessSlider" controls:SliderJump.Enabled="True" Minimum="1" Maximum="25" Value="1"
                        ValueChanged="OnMinBrightnessChanged" Margin="0,8,0,0" />
                <TextBlock Text="RGB 全部低于该级别时抬升到该灰度, 避免灯带彻底熄灭。"
                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="锁屏 / 熄屏 / 切换时灯带策略" FontWeight="SemiBold" />
                <ComboBox x:Name="WaitDispCombo" Margin="0,8,0,0" SelectionChanged="OnWaitDispChanged">
                    <ComboBoxItem Content="熄灭 (默认, 全零帧)" />
                    <ComboBoxItem Content="最暗 (最小亮度灰帧)" />
                    <ComboBoxItem Content="保持最后画面" />
                </ComboBox>
                <TextBlock Text="仅屏幕追光模式受熄屏影响; 进入状态时发一帧策略帧, 每 2s 重发防固件掉电丢帧。"
                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="低灰保真修正 (colorfix)" FontWeight="SemiBold" />
                        <TextBlock Text="厂商原链会把暗灰色放大成蓝绿色; 开启后按绝对色度门限钳为中性灰。"
                                   Opacity="0.45" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ColorfixToggle" HorizontalAlignment="Right"
                                     Click="OnColorfixChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="色度噪声门限 (sfloor)" VerticalAlignment="Center" />
                    <TextBlock x:Name="SfloorValue" Grid.Column="1" Text="24" />
                </Grid>
                <Slider x:Name="SfloorSlider" controls:SliderJump.Enabled="True" Minimum="0" Maximum="255" Value="24"
                        ValueChanged="OnSfloorChanged" Margin="0,8,0,0" />
                <TextBlock Text="8bit max-min 低于该门限视为采样噪声 (0-255, 默认 24)。"
                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="测试图 (校准/排障)" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button x:Name="PatternQuadBtn" Content="四象限色块" Margin="0,0,8,0"
                               Click="OnPatternQuad" />
                    <ui:Button x:Name="PatternMagentaBtn" Content="洋红常亮"
                               Click="OnPatternMagenta" />
                </StackPanel>
                <TextBlock Text="测试图覆盖正常追光画面; 再次点击同一按钮关闭。四象限色块用于核对方向/灯数/分段, 与厂商校准图同构。"
                           Opacity="0.6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="配置目录" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfigDirText" Text="" Opacity="0.7" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="打开" Appearance="Secondary"
                           VerticalAlignment="Center" Margin="8,0,0,0" Click="OnOpenConfigDir" />
            </Grid>
        </ui:Card>

        <TextBlock x:Name="VersionText" Text="" Opacity="0.4" FontSize="11"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Page>
