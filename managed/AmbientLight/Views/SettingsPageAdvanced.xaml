<Page x:Class="AmbientLight.Views.SettingsPageAdvanced"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <!-- M5.1: Win11 设置行式布局, 组标签分组;
         sfloor (仅 colorfix 开启时生效) 折叠进「低灰保真修正」CardExpander -->
    <StackPanel Margin="16,12,16,16">

        <!-- 画面修正 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Adv.Group.Fix}" />
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon LightbulbFilament24}" Title="{DynamicResource Adv.MinBright.Title}"
                             Description="{DynamicResource Adv.MinBright.Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MinBrightnessValue" Text="1" MinWidth="32" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="MinBrightnessSlider" Width="200" Minimum="0" Maximum="25" Value="1"
                        controls:SliderJump.Enabled="True"
                        VerticalAlignment="Center" ValueChanged="OnMinBrightnessChanged" />
            </StackPanel>
        </controls:SettingRow>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon ColorBackground24}" ContentPadding="0">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Adv.Colorfix.Title}" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,8,0"
                               Text="{DynamicResource Adv.Colorfix.Desc}" />
                    <ui:ToggleSwitch x:Name="ColorfixToggle" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                     Margin="0,0,10,0" Click="OnColorfixChanged" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="35,0,16,0">
                        <TextBlock Text="{DynamicResource Adv.Sfloor.Title}" FontSize="14" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{DynamicResource Adv.Sfloor.Desc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SfloorValue" Text="24" MinWidth="32" TextAlignment="Right"
                                   Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Slider x:Name="SfloorSlider" Width="200" Minimum="0" Maximum="255" Value="24"
                                controls:SliderJump.Enabled="True"
                                VerticalAlignment="Center" ValueChanged="OnSfloorChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- 屏幕与电源 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Adv.Group.Misc}" />
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon WeatherMoon24}" Title="{DynamicResource Adv.WaitDisp.Title}"
                             Description="{DynamicResource Adv.WaitDisp.Desc}">
            <ComboBox x:Name="WaitDispCombo" MinWidth="160" VerticalAlignment="Center"
                      SelectionChanged="OnWaitDispChanged">
                <ComboBoxItem Content="{DynamicResource Adv.WaitDisp.Blank}" />
                <ComboBoxItem Content="{DynamicResource Adv.WaitDisp.Dim}" />
                <ComboBoxItem Content="{DynamicResource Adv.WaitDisp.Hold}" />
            </ComboBox>
        </controls:SettingRow>
        <!-- 全屏校准向导已移到「采集」页 (紧挨灯序偏移 —— 那才是它的使用场景) -->

        <!-- 连接 (§8.3): 手动指定端口 / 波特率 —— 换芯片、USB 转串口桥接、两根同型灯带,
             或"端口被别的程序占着"时用。默认全是自动, 不动就不会有副作用。 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Adv.Group.Conn}" />
        <!-- ⚠️ 端口是**每设备**配置 (改的是主页当前选中的那台), 不是全局设置 ——
             说明文案必须写清作用域, 否则用户会以为"我在高级里设过一次, 所有设备都该用它"。 -->
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon UsbPlug24}" Title="{DynamicResource Adv.Port.Title}"
                             Description="{DynamicResource Adv.Port.Desc}">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="RefreshPortsBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                           ToolTip="{DynamicResource Common.ReEnumerate}" Margin="8,0,8,0" VerticalAlignment="Center"
                           Click="OnRefreshPorts">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Button>
                <ComboBox x:Name="PortCombo" MinWidth="160" DisplayMemberPath="Label"
                          VerticalAlignment="Center" SelectionChanged="OnPortChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}" Title="{DynamicResource Adv.Baud.Title}"
                             Description="{DynamicResource Adv.Baud.Desc}">
            <ComboBox x:Name="BaudCombo" MinWidth="160" VerticalAlignment="Center"
                      SelectionChanged="OnBaudChanged" />
        </controls:SettingRow>

        <!-- 界面 (M5.1 §4: banner 底边辉光的实验开关 —— 功耗/手感不对时可随手关掉,
             退回纯渐变 banner; 5.2 主题 / 5.3 语言等界面项后续也落在这里) -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Adv.Group.Ui}" />
        <!-- M5.2 主题: 即时热切换 (走 FluentWindow/WPF-UI 官方管线, 不重启)。
             文案「跟随系统」= 随 Windows 的深/浅色**与强调色**变化自动跟随。 -->
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}" Title="{DynamicResource Adv.Theme.Title}"
                             Description="{DynamicResource Adv.Theme.Desc}">
            <ComboBox x:Name="ThemeCombo" MinWidth="160" VerticalAlignment="Center"
                      SelectionChanged="OnThemeChanged" />
        </controls:SettingRow>
        <!-- M5.3 语言: 与主题同款 —— 立即生效不重启 (换字典 + 广播; 机制见 Services/LanguageService.cs)。
             下拉项是**代码生成**的: 语言名 (简体中文 / English) 必须与当前语言无关 (endonym),
             所以不进字典; 只有「跟随系统」随语言翻。 -->
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24}" Title="{DynamicResource Adv.Lang.Title}"
                             Description="{DynamicResource Adv.Lang.Desc}">
            <ComboBox x:Name="LangCombo" MinWidth="160" VerticalAlignment="Center"
                      SelectionChanged="OnLangChanged" />
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon PaintBrush24}" Title="{DynamicResource Adv.Glow.Title}"
                             Description="{DynamicResource Adv.Glow.Desc}">
            <ui:ToggleSwitch x:Name="BannerGlowToggle" Click="OnBannerGlowChanged" />
        </controls:SettingRow>

        <!-- 启动 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Adv.Group.Start}" />
        <controls:SettingRow x:Name="AutoStartRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon Rocket24}"
                             Title="{DynamicResource Adv.AutoStart.Title}" Description="{DynamicResource Adv.AutoStart.Desc}">
            <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartChanged" />
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Lightbulb24}" Title="{DynamicResource Adv.AutoCore.Title}"
                             Description="{DynamicResource Adv.AutoCore.Desc}">
            <ui:ToggleSwitch x:Name="AutoStartCoreToggle" Click="OnAutoStartCoreChanged" />
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}" Title="{DynamicResource Adv.Minimize.Title}"
                             Description="{DynamicResource Adv.Minimize.Desc}">
            <ui:ToggleSwitch x:Name="StartMinimizedToggle" Click="OnStartMinimizedChanged" />
        </controls:SettingRow>

        <!-- 关于 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Adv.Group.About}" />

        <!-- 版本更新: 手动检查 —— 拉 releases/latest 的 tag_name 与当前版本比大小,
             有新版本只给一个 Release 页面链接, 不下载、不静默更新 (便携软件)。
             说明文案已去掉, 版本号看页脚那一行。 -->
        <controls:SettingRow x:Name="UpdateRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}"
                             Title="{DynamicResource Adv.Update.Title}">
            <ui:Button x:Name="UpdateButton" Content="{DynamicResource Adv.Update.Check}"
                       Appearance="Secondary" VerticalAlignment="Center"
                       Click="OnCheckUpdate" />
        </controls:SettingRow>

        <!-- 配置目录 (可折叠: 折叠内是"恢复默认配置"这种破坏性操作, 收起来减少误触)。
             说明文案已去掉 (原说明里的路径现在只在「打开」后可见)。 -->
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}" ContentPadding="0">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Adv.ConfigDir.Title}" FontSize="14" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="8,0,10,0" Content="{DynamicResource Adv.ConfigDir.Open}" Appearance="Secondary"
                               VerticalAlignment="Center" Click="OnOpenConfigDir" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="35,0,16,0">
                        <TextBlock Text="{DynamicResource Adv.Restore.Title}" FontSize="14" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{DynamicResource Adv.Restore.Hint}" />
                    </StackPanel>
                    <ui:Button x:Name="RestoreDefaultsBtn" Grid.Column="1" Content="{DynamicResource Adv.Restore.Button}"
                               VerticalAlignment="Center" Click="OnRestoreDefaults" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock x:Name="VersionText" Opacity="0.4" FontSize="11"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />
    </StackPanel>
</Page>
