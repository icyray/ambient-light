<Page x:Class="AmbientLight.Views.SettingsPageAudio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <!-- 拾音设置 (M3): 算法为自研包络链 (全频+低频 RMS → AGC → 门限 → 快起慢落),
         参数热更新经 ApplyConfigDebounced; 音量表数据源 = ACStatus.audioLevel。
         M5.1: Win11 设置行式布局 (SettingRow 左标题/说明 + 右控件), 组标签分组 -->
    <StackPanel Margin="16,12,16,16">

        <!-- 音源与设备 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Audio.Group.Source}" />
        <controls:SettingRow x:Name="VolumeRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon DataBarVertical24}" Title="{DynamicResource Audio.Level.Title}"
                             Description="{DynamicResource Audio.Idle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LevelValueText" Text="0" MinWidth="28" TextAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="255" Value="0" Width="200"
                             Height="8" VerticalAlignment="Center" Margin="0,0,10,0" />
                
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon SoundSource24}" Title="{DynamicResource Audio.Source.Title}"
                             Description="{DynamicResource Audio.Source.Desc}">
            <ComboBox x:Name="SourceCombo" Width="160" VerticalAlignment="Center"
                      SelectionChanged="OnSourceChanged">
                <ComboBoxItem Content="{DynamicResource Audio.Source.System}" />
                <ComboBoxItem Content="{DynamicResource Audio.Source.Mic}" />
                <ComboBoxItem Content="{DynamicResource Audio.Source.Firmware}" />
            </ComboBox>
        </controls:SettingRow>
        <controls:SettingRow x:Name="OutDevRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon Speaker224}"
                             Title="{DynamicResource Audio.Out.Title}" controls:AnimatedVisibility.Expanded="False"
                             Description="{DynamicResource Audio.Out.Desc}">
            <StackPanel Orientation="Horizontal">
                <!-- 只要图标, 不要按钮样式 (与主页/采集页一致) -->
                <ui:Button x:Name="RefreshOutDevsBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                           ToolTip="{DynamicResource Common.Refresh}"
                           Margin="8,0,8,0" VerticalAlignment="Center" Click="OnRefreshOutDevs">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Button>
                <ComboBox x:Name="OutDevCombo" Width="160" DisplayMemberPath="Label"
                          VerticalAlignment="Center" SelectionChanged="OnOutDevChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow x:Name="MicDevRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon Mic24}"
                             Title="{DynamicResource Audio.In.Title}" controls:AnimatedVisibility.Expanded="False"
                             Description="{DynamicResource Audio.In.Desc}">
            <StackPanel Orientation="Horizontal">
                <!-- 只要图标, 不要按钮样式 (与主页/采集页一致) -->
                <ui:Button x:Name="RefreshMicDevsBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                           ToolTip="{DynamicResource Common.Refresh}"
                           Margin="8,0,8,0" VerticalAlignment="Center" Click="OnRefreshMicDevs">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Button>
                <ComboBox x:Name="MicDevCombo" Width="160" DisplayMemberPath="Label"
                          VerticalAlignment="Center" SelectionChanged="OnMicDevChanged" />
            </StackPanel>
        </controls:SettingRow>

        <!-- 律动手感 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Audio.Group.Feel}" />
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon ScaleFit24}" Title="{DynamicResource Audio.Agc.Title}"
                             Description="{DynamicResource Audio.Agc.Desc}">
            <ui:ToggleSwitch x:Name="AgcToggle" IsChecked="True" Click="OnAgcChanged" />
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Gauge24}" Title="{DynamicResource Audio.Gain.Title}"
                             Description="{DynamicResource Audio.Gain.Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GainValue" Text="×1.00" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="GainSlider" Width="200" Minimum="0.1" Maximum="5.0" Value="1.0"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnGainChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Filter24}" Title="{DynamicResource Audio.Gate.Title}"
                             Description="{DynamicResource Audio.Gate.Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GateValue" Text="0.30%" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="GateSlider" Width="200" Minimum="0" Maximum="100" Value="30"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnGateChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Wand24}" Title="{DynamicResource Audio.Soft.Title}"
                             Description="{DynamicResource Audio.Soft.Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SoftValue" Text="50%" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="SoftSlider" Width="200" Minimum="0" Maximum="100" Value="50"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnSoftChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}" Title="{DynamicResource Audio.Release.Title}"
                             Description="{DynamicResource Audio.Release.Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ReleaseValue" Text="300 ms" MinWidth="48" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="ReleaseSlider" Width="200" Minimum="50" Maximum="1000" Value="300"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnReleaseChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon MusicNote224}" Title="{DynamicResource Audio.Bass.Title}"
                             Description="{DynamicResource Audio.Bass.Desc}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BassValue" Text="35%" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="BassSlider" Width="200" Minimum="0" Maximum="100" Value="35"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnBassChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Pulse24}" Title="{DynamicResource Audio.Follow.Title}"
                             Description="{DynamicResource Audio.Follow.Desc}">
            <ui:ToggleSwitch x:Name="FollowVolumeToggle" IsChecked="False" Click="OnFollowVolumeChanged" />
        </controls:SettingRow>

    </StackPanel>
</Page>
