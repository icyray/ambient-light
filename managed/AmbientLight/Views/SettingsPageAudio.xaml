<Page x:Class="AmbientLight.Views.SettingsPageAudio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <!-- 拾音设置 (M3): 算法为自研包络链 (全频+低频 RMS → AGC → 门限 → 快起慢落),
         参数热更新经 ApplyConfigDebounced; 音量表数据源 = ACStatus.audioLevel。
         M5.1: Win11 设置行式布局 (SettingRow 左标题/说明 + 右控件), 组标签分组 -->
    <StackPanel Margin="16,12,16,16">

        <!-- 音源与设备 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="音源与设备" />
        <controls:SettingRow x:Name="VolumeRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon DataBarVertical24}" Title="实时音量"
                             Description="开启拾音模式后显示音源与电平">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="255" Value="0" Width="150"
                             Height="8" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="LevelValueText" Text="0" MinWidth="28" TextAlignment="Right"
                           VerticalAlignment="Center" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon SoundSource24}" Title="音源"
                             Description="回环跟电脑播放走; 麦克风收环境声 (需在系统隐私设置放行); 固件自拾音多数硬件无麦克风, 仅 0.25s 闪烁 (原厂同样)">
            <ComboBox x:Name="SourceCombo" Width="200" VerticalAlignment="Center"
                      SelectionChanged="OnSourceChanged">
                <ComboBoxItem Content="系统声音" />
                <ComboBoxItem Content="麦克风" />
                <ComboBoxItem Content="固件自拾音" />
            </ComboBox>
        </controls:SettingRow>
        <controls:SettingRow x:Name="OutDevRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon Speaker224}"
                             Title="输出设备" controls:AnimatedVisibility.Expanded="False"
                             Description="可选非默认输出; 拔出自动回退默认, 重插自动切回">
            <StackPanel Orientation="Horizontal">
                <!-- 只要图标, 不要按钮样式 (轮 29 用户要求, 与主页/采集页一致) -->
                <ui:Button x:Name="RefreshOutDevsBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                           ToolTip="刷新"
                           Margin="8,0,8,0" VerticalAlignment="Center" Click="OnRefreshOutDevs">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Button>
                <ComboBox x:Name="OutDevCombo" Width="200" DisplayMemberPath="Label"
                          VerticalAlignment="Center" SelectionChanged="OnOutDevChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow x:Name="MicDevRow" Margin="0,0,0,4" Icon="{ui:SymbolIcon Mic24}"
                             Title="输入设备" controls:AnimatedVisibility.Expanded="False"
                             Description="拔出自动回退默认, 重插自动切回">
            <StackPanel Orientation="Horizontal">
                <!-- 只要图标, 不要按钮样式 (轮 29 用户要求, 与主页/采集页一致) -->
                <ui:Button x:Name="RefreshMicDevsBtn" Template="{StaticResource IconOnlyButtonTemplate}"
                           ToolTip="刷新"
                           Margin="8,0,8,0" VerticalAlignment="Center" Click="OnRefreshMicDevs">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:Button>
                <ComboBox x:Name="MicDevCombo" Width="200" DisplayMemberPath="Label"
                          VerticalAlignment="Center" SelectionChanged="OnMicDevChanged" />
            </StackPanel>
        </controls:SettingRow>

        <!-- 律动手感 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="律动手感" />
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon ScaleFit24}" Title="自动增益"
                             Description="跟踪近几秒峰值自动归一, 安静音源也能满幅律动">
            <ui:ToggleSwitch x:Name="AgcToggle" IsChecked="True" Click="OnAgcChanged" />
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Gauge24}" Title="灵敏度"
                             Description="手动增益, 与自动增益相乘">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GainValue" Text="×1.00" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="GainSlider" Width="200" Minimum="0.1" Maximum="5.0" Value="1.0"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnGainChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Filter24}" Title="底噪门限"
                             Description="低于此响度视为静默 (灯全灭); 底噪常亮调大, 安静段太灵敏调小">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GateValue" Text="0.30%" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="GateSlider" Width="200" Minimum="0" Maximum="100" Value="30"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnGateChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Wand24}" Title="柔和度"
                             Description="0% 硬包络最跟手 (大动态有频闪感); 越高起音越缓、间隙不再深黑">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SoftValue" Text="50%" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="SoftSlider" Width="200" Minimum="0" Maximum="100" Value="50"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnSoftChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}" Title="回落时长"
                             Description="峰值消失后灯光熄灭的快慢; 短干脆, 长余韵">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ReleaseValue" Text="300 ms" MinWidth="48" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="ReleaseSlider" Width="200" Minimum="50" Maximum="1000" Value="300"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnReleaseChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon MusicNote224}" Title="低频加权"
                             Description="0% 跟整体响度; 100% 只跟鼓点/贝斯 (低频独立归一)">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BassValue" Text="35%" MinWidth="40" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="BassSlider" Width="200" Minimum="0" Maximum="100" Value="35"
                        controls:SliderJump.Enabled="True" VerticalAlignment="Center" ValueChanged="OnBassChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Pulse24}" Title="跟随系统音量"
                             Description="音量调低时灯光幅度同步变小 (关闭 = 只看内容)">
            <ui:ToggleSwitch x:Name="FollowVolumeToggle" IsChecked="False" Click="OnFollowVolumeChanged" />
        </controls:SettingRow>

    </StackPanel>
</Page>
