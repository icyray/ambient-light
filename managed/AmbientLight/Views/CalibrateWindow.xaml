<Window x:Class="AmbientLight.Views.CalibrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:AmbientLight.Controls"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Black"
        Topmost="True" Title="{DynamicResource Calib.WindowTitle}"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- 全屏四色校准 (厂商 FormCalibrate 同构): 灯带以屏幕追光模式采集本屏,
         每颗灯应显示其取色区所在象限的颜色; 中央面板不进取色带 (校准期间取色带临时调窄)。 -->
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="QuadTL" Grid.Column="0" Grid.Row="0" Background="#FFFF0000" />
            <Border x:Name="QuadTR" Grid.Column="1" Grid.Row="0" Background="#FF00FF00" />
            <Border x:Name="QuadBL" Grid.Column="0" Grid.Row="1" Background="#FF0000FF" />
            <Border x:Name="QuadBR" Grid.Column="1" Grid.Row="1" Background="#FFFFFF00" />
        </Grid>

        <!-- 面板宽度 = MinWidth 而不是固定 Width —— UniformGrid 是**等宽四列**、格宽 = 面板内宽/4,
             格子自己不会长; 于是"某个语言的按钮文案比格宽还长"时文字会顶出格子 (压到邻居上)。
             改成 MinWidth 后: 文案装得下就还是 520 (观感不变), 装不下时**面板整体变宽**把格子撑开。
             ⚠️ 代价: 面板一旦可自适应, 里面**会折行的文本必须自己设 MaxWidth**, 否则它们会按"一整行不折"
             去要宽度 → 把面板撑得极宽。所以下面的 Intro / Footer 都钉了 520 (= 560 − 2×20 内边距)。 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="560"
                Background="#E6141418" CornerRadius="12" Padding="20"
                TextElement.Foreground="White">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{DynamicResource Calib.Title}" FontSize="20" FontWeight="SemiBold" />
                    <ui:Button Content="{DynamicResource Common.Close}" Appearance="Secondary" HorizontalAlignment="Right"
                               Click="OnClose" KeyboardNavigation.IsTabStop="True" />
                </Grid>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85" MaxWidth="520"
                           Text="{DynamicResource Calib.Intro}" TextAlignment="Justify" LineHeight="20"/>
                <!-- 分隔线用**本地白 alpha**而不是 ui:Separator (M5.2): Separator 的描边走主题资源,
                     浅色主题下会变成一条深色线压在 #E6141418 的深面板上。 -->
                <Border Height="1" Margin="0,12" Background="#33FFFFFF" />

                <TextBlock x:Name="SchemeText" Text="" Opacity="0.75" />
                <TextBlock x:Name="ResText" Text="" Opacity="0.75" Margin="0,4,0,0" />
                <TextBlock x:Name="RotateText" Text="" Opacity="0.75" Margin="0,4,0,0" />
                <TextBlock x:Name="IndexText" Text="" Opacity="0.75" Margin="0,4,0,0" />
                <TextBlock x:Name="StatusText" Text="" Opacity="0.5" Margin="0,4,0,0" />

                <!-- Surface=AlwaysDark: 这个面板是**恒深**的 (校色时不能被主题影响),
                     所以整套外观恒深 —— 屏幕矩形/中心文字/灯珠描边都不随主题变。
                     (主页那边用默认的 Theme: 浅色主题下矩形/文字也变浅。) -->
                <controls:LedRingView x:Name="Ring" MinHeight="150" Margin="0,12,0,0"
                                      Surface="AlwaysDark" />

                <UniformGrid Columns="4" Margin="0,12,0,0">
                    <ui:Button x:Name="RotLeftBtn" Content="{DynamicResource Calib.ShiftLeft}"
                               HorizontalAlignment="Center" MinWidth="80" Click="OnRotLeft" />
                    <ui:Button x:Name="RotRightBtn" Content="{DynamicResource Calib.ShiftRight}" 
                               HorizontalAlignment="Center" MinWidth="80" Click="OnRotRight" />
                    <ui:Button x:Name="RotResetBtn" Content="{DynamicResource Calib.Reset}" 
                               HorizontalAlignment="Center" MinWidth="80" Click="OnRotReset" />
                    <ui:Button Content="{DynamicResource Calib.ChangeColors}" 
                               HorizontalAlignment="Center" MinWidth="80" Click="OnRotateColors" />
                </UniformGrid>
                <TextBlock Text="{DynamicResource Calib.Footer}" MaxWidth="520"
                           Opacity="0.6" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" 
                           TextAlignment="Justify"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
