<Page x:Class="AmbientLight.Views.SettingsPageColor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:AmbientLight.Controls">
    <!-- 颜色设置: 数值范围与厂商 FormSettings 一致
         (饱和度/色相 0-200→0-20/0-2, 伽马 30-100→0.30-1.00, cut 0-25, 增益 0-200→0-2)。
         M5.1: 行式布局; 滑块行统一"值左滑右"; RGB 通道增益折叠进「LED 色彩平衡」
         (三行等距, 色块+白字+值+滑块); 纯色拾色器已迁至主页模式区 -->
    <StackPanel Margin="16,12,16,16">

        <!-- 色彩调整 -->
        <TextBlock Style="{StaticResource GroupLabel}" Text="色彩调整" />
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon PaintBucket24}" Title="饱和度"
                             Description="画面色彩鲜艳程度">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="VibranceValue" Text="9.0" MinWidth="32" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="VibranceSlider" Width="200" Minimum="0" Maximum="20" Value="9"
                        SmallChange="0.1" controls:SliderJump.Enabled="True"
                        VerticalAlignment="Center" ValueChanged="OnVibranceChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon ColorLine24}" Title="色相强度"
                             Description="整体色相偏移; 1.00 为原色, 调大色相偏红, 调小偏黄绿">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HueValue" Text="1.00" MinWidth="32" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="HueSlider" Width="200" Minimum="0" Maximum="2" Value="1"
                        SmallChange="0.01" controls:SliderJump.Enabled="True"
                        VerticalAlignment="Center" ValueChanged="OnHueChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon BrightnessLow24}" Title="明暗强度 (伽马)"
                             Description="画面明暗向灯带的映射曲线">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GammaValue" Text="0.65" MinWidth="32" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="GammaSlider" Width="200" Minimum="0.3" Maximum="1" Value="0.65"
                        SmallChange="0.01" controls:SliderJump.Enabled="True"
                        VerticalAlignment="Center" ValueChanged="OnGammaChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon Filter24}" Title="最低颜色亮度 (cut)"
                             Description="RGB 全部低于该级别的颜色不显示 (压黑)">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ColorCutValue" Text="1" MinWidth="32" TextAlignment="Right"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <Slider x:Name="ColorCutSlider" Width="200" Minimum="0" Maximum="25" Value="1"
                        controls:SliderJump.Enabled="True"
                        VerticalAlignment="Center" ValueChanged="OnColorCutChanged" />
            </StackPanel>
        </controls:SettingRow>
        <controls:SettingRow Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Title="灯珠色序"
                             Description="颜色不符时逐个尝试 (灯珠接线序差异)">
            <ComboBox x:Name="OutputCombo" Width="120" VerticalAlignment="Center"
                      SelectionChanged="OnOutputChanged">
                <ComboBoxItem Content="RGB" />
                <ComboBoxItem Content="GBR" />
                <ComboBoxItem Content="BRG" />
                <ComboBoxItem Content="RBG" />
                <ComboBoxItem Content="GRB" />
                <ComboBoxItem Content="BGR" />
            </ComboBox>
        </controls:SettingRow>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Options24}" ContentPadding="0">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LED 色彩平衡" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="分通道增益, 白场偏色时微调 (高级)" />
                    <TextBlock x:Name="GainSummaryText" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                               Text="×1.00 ×1.00 ×1.00" FontSize="12" Margin="8,0,4,0"
                               VerticalAlignment="Center" />
                </Grid>
            </ui:CardExpander.Header>
            <!-- 三行等距: 统一行距 10, 色块+白字+值+滑块 (与主页拾色器 RGB 行同款) -->
            <StackPanel Margin="16,12,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#FF6B6B"/>
                        <TextBlock Text="R" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="RGainValue" Grid.Column="1" Text="1.00" MinWidth="36"
                               TextAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center" />
                    <Slider x:Name="RGainSlider" Grid.Column="2" Width="200" Minimum="0" Maximum="2" Value="1"
                            SmallChange="0.01" controls:SliderJump.Enabled="True"
                            VerticalAlignment="Center" ValueChanged="OnRGainChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#7DD97D"/>
                        <TextBlock Text="G" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="GGainValue" Grid.Column="1" Text="1.00" MinWidth="36"
                               TextAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center" />
                    <Slider x:Name="GGainSlider" Grid.Column="2" Width="200" Minimum="0" Maximum="2" Value="1"
                            SmallChange="0.01" controls:SliderJump.Enabled="True"
                            VerticalAlignment="Center" ValueChanged="OnGGainChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#7D9DFF"/>
                        <TextBlock Text="B" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="BGainValue" Grid.Column="1" Text="1.00" MinWidth="36"
                               TextAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center" />
                    <Slider x:Name="BGainSlider" Grid.Column="2" Width="200" Minimum="0" Maximum="2" Value="1"
                            SmallChange="0.01" controls:SliderJump.Enabled="True"
                            VerticalAlignment="Center" ValueChanged="OnBGainChanged" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

    </StackPanel>
</Page>
