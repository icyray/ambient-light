<Page x:Class="AmbientLight.Views.SettingsPageColor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 颜色设置: 数值范围与厂商 FormSettings 一致
         (饱和度/色相 0-200→0-20/0-2, 伽马 30-100→0.30-1.00, cut 0-25, 增益 0-200→0-2) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,16,16" MaxWidth="760" HorizontalAlignment="Left">

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="色彩饱和度 (鲜艳度)" FontWeight="SemiBold" />
                        <TextBlock x:Name="VibranceValue" Text="9.0" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="VibranceSlider" Minimum="0" Maximum="20" Value="9"
                            SmallChange="0.1" ValueChanged="OnVibranceChanged" Margin="0,8,0,0" />
                    <Separator Margin="0,10" />
                    <Grid>
                        <TextBlock Text="色相强度" FontWeight="SemiBold" />
                        <TextBlock x:Name="HueValue" Text="1.00" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="2" Value="1"
                            SmallChange="0.01" ValueChanged="OnHueChanged" Margin="0,8,0,0" />
                    <Separator Margin="0,10" />
                    <Grid>
                        <TextBlock Text="明暗强度 (伽马)" FontWeight="SemiBold" />
                        <TextBlock x:Name="GammaValue" Text="0.65" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="GammaSlider" Minimum="0.3" Maximum="1" Value="0.65"
                            SmallChange="0.01" ValueChanged="OnGammaChanged" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="最低颜色亮度 (cut)" FontWeight="SemiBold" />
                        <TextBlock x:Name="ColorCutValue" Text="1" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="ColorCutSlider" Minimum="0" Maximum="25" Value="1"
                            ValueChanged="OnColorCutChanged" Margin="0,8,0,0" />
                    <TextBlock Text="RGB 全部低于该级别的颜色不显示 (压黑)。"
                               Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Separator Margin="0,10" />
                    <TextBlock Text="LED 色彩平衡 (通道增益)" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="红" Foreground="#FF6B6B" VerticalAlignment="Center" />
                        <Slider x:Name="RGainSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1"
                                SmallChange="0.01" ValueChanged="OnRGainChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="RGainValue" Grid.Column="2" Text="1.00" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="绿" Foreground="#7DD97D" VerticalAlignment="Center" />
                        <Slider x:Name="GGainSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1"
                                SmallChange="0.01" ValueChanged="OnGGainChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="GGainValue" Grid.Column="2" Text="1.00" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="蓝" Foreground="#7D9DFF" VerticalAlignment="Center" />
                        <Slider x:Name="BGainSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1"
                                SmallChange="0.01" ValueChanged="OnBGainChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="BGainValue" Grid.Column="2" Text="1.00" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Separator Margin="0,10" />
                    <TextBlock Text="LED 颜色输出 (灯珠色序)" FontWeight="SemiBold" />
                    <ComboBox x:Name="OutputCombo" Margin="0,8,0,0" SelectionChanged="OnOutputChanged">
                        <ComboBoxItem Content="RGB" />
                        <ComboBoxItem Content="GBR" />
                        <ComboBoxItem Content="BRG" />
                        <ComboBoxItem Content="RBG" />
                        <ComboBoxItem Content="GRB" />
                        <ComboBoxItem Content="BGR" />
                    </ComboBox>
                    <TextBlock Text="灯光颜色与预期不符时, 逐个尝试直到正确 (灯珠接线序差异)。"
                               Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="纯色灯光 (模式 11)" FontWeight="SemiBold" />
                        <TextBlock Text="在主页模式宫格选择「纯色灯光」生效"
                                   Opacity="0.45" FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SolidPreview" Grid.Column="0" Width="48" Height="48"
                                CornerRadius="8" Background="#FFE1D6" BorderBrush="#3A3A44"
                                BorderThickness="1" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <ItemsControl x:Name="PresetStrip">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HEX" VerticalAlignment="Center" Opacity="0.7" />
                                <ui:TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0,0,0" Text="#FFE1D6"
                                            TextChanged="OnHexChanged" MaxLength="9" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R" Foreground="#FF6B6B" VerticalAlignment="Center" />
                        <Slider x:Name="SRSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="255"
                                ValueChanged="OnSolidRgbChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="SRValue" Grid.Column="2" Text="255" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="G" Foreground="#7DD97D" VerticalAlignment="Center" />
                        <Slider x:Name="SGSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="225"
                                ValueChanged="OnSolidRgbChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="SGValue" Grid.Column="2" Text="225" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B" Foreground="#7D9DFF" VerticalAlignment="Center" />
                        <Slider x:Name="SBSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="214"
                                ValueChanged="OnSolidRgbChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="SBValue" Grid.Column="2" Text="214" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
