// probe_devices.cs — 隔离验证 AC_GetDevices / AC_GetMonitors / AC_Start 状态机
using System.Runtime.InteropServices;
using System.Text;

var lib = Path.Combine(@"D:\Codes\ambient-light\managed\AmbientLight\bin\Debug\net10.0-windows\win-x64", "AmbientCore.dll");
NativeLibrary.SetDllImportResolver(typeof(Native).Assembly, (name, asm, path) =>
    NativeLibrary.Load(lib));

var st = new ACStatus { structSize = (uint)Marshal.SizeOf<ACStatus>() };
Native.AC_GetStatus(ref st);
Console.WriteLine($"version=0x{Native.AC_Version():X} state={st.state}");

var mons = new ACMonitorInfo[8];
int monCount = 0;
int rc = Native.AC_GetMonitors(mons, 8, ref monCount);
Console.WriteLine($"monitors rc={rc} n={monCount}");
for (int i = 0; i < monCount; i++)
    Console.WriteLine($"  [{i}] {S(mons[i].name)} {mons[i].width}x{mons[i].height} primary={mons[i].primary}");

var devs = new ACDeviceInfo[8];
int devCount = 0;
rc = Native.AC_GetDevices(devs, 8, ref devCount);
Console.WriteLine($"devices rc={rc} n={devCount}");
for (int i = 0; i < devCount; i++)
    Console.WriteLine($"  [{i}] {S(devs[i].comPort)} type={devs[i].devType} id={devs[i].devId} inUse={devs[i].inUse}");

static string S(byte* p) { int n = 0; while (n < 32 && p[n] != 0) n++; return Encoding.UTF8.GetString(p, n); }

internal static unsafe partial class Native
{
    [DllImport("AmbientCore.dll", CallingConvention = CallingConvention.Cdecl)]
    internal static extern uint AC_Version();

    [DllImport("AmbientCore.dll", CallingConvention = CallingConvention.Cdecl)]
    internal static extern int AC_GetMonitors(ACMonitorInfo* p, uint max, ref int count);

    [DllImport("AmbientCore.dll", CallingConvention = CallingConvention.Cdecl)]
    internal static extern int AC_GetDevices(ACDeviceInfo* p, uint max, ref int count);

    [DllImport("AmbientCore.dll", CallingConvention = CallingConvention.Cdecl)]
    internal static extern void AC_GetStatus(ref ACStatus st);
}

[StructLayout(LayoutKind.Sequential, Pack = 8)]
internal unsafe struct ACStatus
{
    public uint structSize;
    public int state;
    public int devType;
    public int devId;
    public fixed byte comPort[16];
    public uint ledStatusByte;
    public uint deviceChanged;
    public int monitorFallback;
    public uint allBlackFrames;
    public float fps;
    public float procMs;
    public float wireMs;
    public float cpuPercent;
    public fixed int margins[4];
    public uint frameCounter;
}

[StructLayout(LayoutKind.Sequential, Pack = 8)]
internal unsafe struct ACMonitorInfo
{
    public fixed byte name[32];
    public fixed byte adapter[32];
    public int width;
    public int height;
    public int primary;
}

[StructLayout(LayoutKind.Sequential, Pack = 8)]
internal unsafe struct ACDeviceInfo
{
    public fixed byte comPort[16];
    public int devType;
    public int devId;
    public int inUse;
}
